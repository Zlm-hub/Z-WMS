# =========================================================
# ModernWMS 部署环境配置模板
# 用法：复制本文件为同目录 .env（docker compose 自动读取），按需修改。
#       不创建 .env 也能跑——compose 里全部有内置默认值。
#       改完执行: docker compose up -d  生效。
# =========================================================

# ---------- 数据库 ----------
# 可选值：SqlLite（默认，零配置，数据落盘到 docker volume）
#         MySql（需同时启用 compose 里 mysql 服务段，并先建表，见启动指南）
WMS_DB_TYPE=SqlLite
# Database__db=MySql 时生效的连接串
WMS_MYSQL_CONN=Server=mysql;Database=wms;Port=3306;charset=utf8;uid=root;pwd=modernwms;

# ---------- 安全（生产环境必改！）----------
# JWT 签名密钥：至少 64 位随机字符串。生成方式：openssl rand -hex 48
WMS_JWT_SIGNINGKEY=wms-2026-secure-key-8f4e2a91c7d5b3e6a0f9d8c7b2e4a6f1d3c5e7b9a2f4d6c8e0b2a4f6d8c1e3a5
# Hangfire 后台任务面板（/hangfire）Basic 认证账号；留空则仅允许容器本机访问
WMS_HANGFIRE_USER=admin
WMS_HANGFIRE_PASS=hangfire2026

# ---------- 端口映射（宿主机侧）----------
BACKEND_PORT=20011
FRONTEND_V1_PORT=8080
FRONTEND_V2_PORT=8081

# ---------- MySQL 容器（可选，启用 mysql 服务段时生效）----------
MYSQL_ROOT_PASSWORD=modernwms
